# Copy this file to `.env.local` and fill in the values.
# Vite exposes variables that start with `VITE_` to the client.
# Do NOT commit your real keys. Keep `.env.local` out of version control.

# Supabase project URL (example: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for client-side usage)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated emails allowed to use admin login (default: suleimanahmed1222@gmail.com)
# VITE_ALLOWED_ADMIN_EMAILS=suleimanahmed1222@gmail.com

# Optional: for server-side/CI tasks that require elevated privileges
# Use this only on the server (never expose in client-side bundle)
# SUPABASE_SERVICE_ROLE_KEY=
